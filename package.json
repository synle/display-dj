{
  "name": "display-dj",
  "version": "12.7.0",
  "type": "module",
  "description": "Cross-platform desktop app for monitor brightness, contrast, and dark mode control",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:update-snapshots": "vitest run --update=all",
    "tauri": "tauri",
    "format": "oxfmt --write .",
    "postformat": "node scripts/sync-version.mjs && npm run format:rust",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "oxfmt --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "oxlint . --ignore-pattern=src/binaries"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-shell": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "29.1.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.83.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
